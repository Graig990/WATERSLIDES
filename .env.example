# ---------------------------------------------------------------
# Copy to .env.local and fill in. Every value here is optional —
# with none of them set the site still builds and runs.
# ---------------------------------------------------------------

# Canonical origin. Used for canonical tags, OG URLs, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://waterslides4kids.com

# --- Payments ---------------------------------------------------
# There are no payment env vars. Every method the site accepts
# (Zelle, Chime, Cash App, Apple Pay, crypto) settles manually, and
# the account handles and wallet addresses live in
# src/data/payments.ts so they are reviewable in version control
# rather than hidden in an environment variable.
#
# Fill that file in before launch. Until you do, the checkout still
# works end to end and tells customers you will email the payment
# details rather than displaying an account that does not exist.

# --- Search engine / analytics verification ---------------------
# Each renders a <meta> tag in <head> only when set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
