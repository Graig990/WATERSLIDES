# ---------------------------------------------------------------
# Copy to .env.local and fill in. Every value here is optional —
# with none of them set the site still builds and the checkout
# falls back to demo mode.
# ---------------------------------------------------------------

# Canonical origin. Used for canonical tags, OG URLs, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://waterslides4kids.com

# --- Stripe -----------------------------------------------------
# Leave BOTH blank to run the built-in demo checkout.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Search engine / analytics verification ---------------------
# Each renders a <meta> tag in <head> only when set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
